# Pi Web 手动配置模板
#
# 用法：把本文件复制到仓库根目录并命名为 .env，再填入你的值：
#     cp deploy/.env.example .env
#     vim .env
# 然后运行启动脚本即可生效：
#     sudo bash deploy/start.sh <你的域名>
#
# 注意：
#   - 密码为必填，请设置足够长的高强度随机密码（登录用户名默认 pi）。
#   - .env 内含敏感信息，务必不要提交到 git；建议加入 .gitignore。
#   - 只要本文件存在，运行 deploy/start.sh 就会以本文件为准，整体同步到
#     /etc/pi-web/pi-web.env —— 改动任何一个变量重跑脚本都会生效。
#   - 若 .env 未设置 PI_WEB_PASSWORD，脚本会生成随机密码并把服务配上认证（不会留空）。

# 访问密码（必填）。默认登录用户名固定为 pi；如需自定义，见下方 PI_WEB_USERNAME。
PI_WEB_PASSWORD=please-set-a-strong-password

# 登录用户名（可选，默认 pi）。可改为你想要的用户名。
# 注意：这不会加密，需与密码配合；用户名会由服务通过 PI_WEB_USERNAME 读取。
PI_WEB_USERNAME=pi

# 反向代理传入的域名白名单（多个用英文逗号分隔，需精确匹配 Host）。
# 若不设，脚本会使用启动脚本第一个参数（或默认 agent.example.com）。
PI_WEB_ALLOWED_HOSTS=agent.example.com

# ---- 以下为可选配置（有默认值，不填也能用） ----

# 服务运行的系统账户（默认 pi-web）
# PI_WEB_USER=pi-web

# 服务端口（默认 30141）。若反向代理已转发到其他端口（例如你的 Nginx 转发到 5230），
# 请把这里改成与代理一致，并保证脚本能读取到（脚本会透传到 systemd 的 PORT）。
PORT=30141

# 监听地址（默认 127.0.0.1，不对外直接暴露）
# HOSTNAME=127.0.0.1